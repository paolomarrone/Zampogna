pi = 3.141592653589793

b, R0 = wdf_resistor(a, R) {
	b = 0
	R0 = R
}

b, R0 = wdf_capacitor(a, C) {
	b = delay1(a)
	R0 = 0.5 / (C * fs)
}

b = wdf_voltage_source_root(a, voltage) {
	b = 2 * voltage - a
}

bu, bl, br, R0 = wdf_3port_series(au, al, ar, Rl, Rr) {
	sum = au + al + ar
	R0 = Rl + Rr
	bu = -(al + ar)
	bl = al - (Rl / R0) * sum
	br = ar - (Rr / R0) * sum
}

y = rc_highpass(x, cutoff) {
	frequency = (0.001 + 0.249 * cutoff) * fs
	C = 1e-6
	R = 1 / (2 * pi * frequency * C)

	bR, RR = wdf_resistor(aR, R)
	bC, RC = wdf_capacitor(aC, C)
	bV = wdf_voltage_source_root(aV, x)
	aV, aR, aC, Rp = wdf_3port_series(bV, bR, bC, RR, RC)
	@aC = 0

	y = -0.5 * (aR + bR)
}

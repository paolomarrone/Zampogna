float y = delay (float x) {
	mem[1] float s
	y = s[0]
	s[0] = x
	s.init = x
}

pi = 3.141592653589793
pi2 = pi * 2.0

# Backward Euler method
y = lp1(x, s) {
	fc = 1000.0
	B0 = (pi2 * fc) / (fs + pi2 * fc)
	A1 = -fs / (fs + pi2 * fc)
	y = B0 * x - A1 * s
}

y = lp1_bypass(x, bypass) {
	# These delays run every sample, including bypassed samples.
	previous_x = delay(x)
	previous_bypass = delay(bypass)

	y = if (bypass > 0.5) {
		y = x
	} else {
		# Filter history advances only while the filter is selected.
		previous_t = delay(t)
		s = if (previous_bypass > 0.5) {
			# On leaving bypass, start from the previous input sample.
			s = previous_x
		} else {
			s = previous_t
		}
		t = lp1(x, s)
		t.init = 0.0
		y = t
	}
}

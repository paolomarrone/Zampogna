float y = delay (float x) {
	mem[1] float s
	y = s[0]
	s[0] = x
	s.init = x
}

bool y = delay (bool x) {
    mem[1] bool s
    y = s[0]
    s[0] = x
    s.init = x
}

y = decimator(x, bypass) {
	y = if (bypass < 0.5) {
		bool take = !delay(take)
		take.init = false
		# Run on the outer branch clock, so the inner else can hold the last output.
		previous_y = delay(y)
		y = if (take) {
			y = x
		} else {
			y = previous_y
		}
		y.init = 0.0
	} else {
		y = x
	}
}
